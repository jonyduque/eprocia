{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "EPROCIA_HARNESS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go tool benchstat:*)",
      "Bash(go run ./scripts/bench/gerar:*)",
      "Bash(gofmt -l:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/visual/capturar.mjs:*)",
      "Bash(npm run build:*)",
      "Bash(npx svelte-check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ambiente.mjs\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-gerados.mjs\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-dados.mjs\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-bench.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/go-check.mjs\"", "timeout": 20 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/front-check.mjs\"", "timeout": 90 }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/statusline.mjs\""
  }
}
